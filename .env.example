# ==============================================================================
# Aegis SRE - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Meta Model API (Current Step)
# ------------------------------------------------------------------------------
# Your API key from the Meta Model API portal ($150 credit grant)
# or Baseten inference endpoint key.
META_API_KEY=your_meta_api_key_here

# Meta Model API Base URL (defaults to standard Meta Model API endpoint or partner URL)
META_MODEL_API_URL=https://api.meta.ai/v1

# Target Model: muse-spark or partner equivalent (e.g. meta-models/muse-spark-open-1026)
META_MODEL_NAME=muse-spark

# ------------------------------------------------------------------------------
# 2. Modal Cloud Infrastructure (Step 2)
# ------------------------------------------------------------------------------
# Claimed through the $100 Modal credits form
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ------------------------------------------------------------------------------
# 3. GitHub Pull Request Delivery (Step 3)
# ------------------------------------------------------------------------------
# Personal Access Token with 'repo' scope
GITHUB_TOKEN=
GITHUB_REPOSITORY=meta-sre/payment-client
