{
  "openapi": "3.0.3",
  "info": {
    "title": "Stripe-Compatible Payment Gateway API",
    "version": "2.0.0"
  },
  "paths": {
    "/api/v2/payments/charge": {
      "post": {
        "summary": "Process a customer payment charge (v2 Breaking Specification)",
        "operationId": "createChargeV2",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customer_id", "amount_cents", "currency", "billing"],
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Unique customer reference ID"
                  },
                  "amount_cents": {
                    "type": "integer",
                    "description": "Charge amount strictly in integer cents (e.g., 4999 instead of 49.99)"
                  },
                  "currency": {
                    "type": "string",
                    "description": "ISO 4217 currency code (e.g., USD)"
                  },
                  "billing": {
                    "type": "object",
                    "required": ["address"],
                    "properties": {
                      "address": {
                        "type": "object",
                        "required": ["line1"],
                        "properties": {
                          "line1": {
                            "type": "string",
                            "description": "Primary street address moved to billing.address.line1"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["charge_id", "status"],
                  "properties": {
                    "charge_id": {"type": "string"},
                    "status": {"type": "string", "example": "succeeded"}
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity - Schema Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {"type": "string"},
                    "validation_errors": {"type": "array", "items": {"type": "string"}}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
